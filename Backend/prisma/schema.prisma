// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
   provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}


model Tenant {
  id Int @id @default(autoincrement())
  name String 
  slug String @unique
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  attendanceSettings AttendanceSetting[]
  webhooks Webhook[]
  leaveAndHolidays LeaveAndHoliday[]
  leaveSubTypes LeaveSubType[]
  departments Department[]
  designations Designation[]
  attendances         Attendance[]
  specialAttendances  SpecialAttendance[]
  attendanceRegularizations AttendanceRegularization[]
  bodyguardEnabled Boolean @default(false)
  @@map("tenant")
}

model User { 
  id    Int     @id @default(autoincrement()) 
  employeeName  String?
  employeeId String?
  shift String?
  email String  @unique
  mobileNumber String  @unique
  pin   String
  deviceId String? @db.VarChar(625)
  refreshToken String? @db.VarChar(625)
  joinDate DateTime?
  userType UserType @default(EMPLOYEE)
  workLocation Json? 
  weekendOff Json?
  attendances Attendance[] 
  skipLocationCheck Boolean? @default(false)
  specialAttendances SpecialAttendance[]
  regularizations AttendanceRegularization[]
  reviewedRegularizations AttendanceRegularization[] @relation("RegularizeReviewer")
  departmentId Int?
  designationId Int?
  leaves LeaveEmployee[]

  department      Department? @relation(fields: [departmentId], references: [id])
  designation     Designation? @relation(fields: [designationId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  tenantId Int?
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("user")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])
  date      DateTime
  status    status @default(PRESENT)
  checkInTime DateTime?
  checkOutTime DateTime?
  checkInLocation String?
  checkOutLocation String?
  checkInPhoto String?
  checkOutPhoto String?
  extraTime String?
  checkoutOutside Boolean? @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId Int?
  tenant Tenant? @relation(fields: [tenantId], references: [id])
  regularizations AttendanceRegularization[]

  @@index([tenantId])
  @@map("attendance")
}

model SpecialAttendance {
  id        Int      @id @default(autoincrement())
  userId    Int
  user   User @relation(fields: [userId], references: [id])
  date      DateTime
  checkInTime DateTime?
  checkOutTime DateTime?
  checkInLocation String?
  checkOutLocation String?
  checkInPhoto String?
  checkOutPhoto String?
  workHours String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId Int?
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("special_attendance")
}

model LeaveAndHoliday {
  id         Int      @id @default(autoincrement())
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     Status   @default(LEAVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  subTypeId  Int?
  subType    LeaveSubType? @relation(fields: [subTypeId], references: [id], onDelete: SetNull)
  employees LeaveEmployee[]
  tenantId Int?
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([subTypeId])
  @@index([tenantId])
  @@map("leave_and_holiday")
}

model LeaveSubType {
  id Int @id @default(autoincrement())
  type Type? @default(LEAVE)
  name String
  leaves LeaveAndHoliday[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())
  tenantId Int?
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("leave_sub_type")
}

enum Type {
  LEAVE
  HOLIDAY
}

model LeaveEmployee {
  id          Int @id @default(autoincrement())
  leaveId     Int
  employeeId  Int

  leave LeaveAndHoliday @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([leaveId])
  @@index([employeeId])
  @@map("leave_employee")
}

model Department {
  id   Int    @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  users User[]
  tenantId Int?
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("department")
}

model Designation {
  id   Int    @id @default(autoincrement())
  name String
  users User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  tenantId Int?
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("designation")
}

model Webhook {
  id        Int      @id @default(autoincrement())
  url       String
  eventType String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId Int?
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("webhook")
}

model AttendanceSetting {
  id        Int      @id @default(autoincrement())
  lateBufferMinutes Int @default(15)
  checkInRadius Int @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId Int?
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId])
  @@map("attendance_setting")
}

enum Status {
  LEAVE
  HOLIDAY
}

enum UserType {
  EMPLOYEE
  ADMIN
  BODYGUARD
  SUPERADMIN
}

enum status {
  PRESENT
  OVERTIME
  WORK_FROM_HOME
  HALF_DAY
  LATE
  ABSENT
}

enum RegularizeStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceRegularization {
  id                  Int               @id @default(autoincrement())
  userId              Int
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime
  requestedCheckIn    DateTime
  requestedCheckOut   DateTime
  reason              String            @db.Text
  status              RegularizeStatus  @default(PENDING)
  adminNote           String?           @db.Text
  reviewedById        Int?
  reviewedBy          User?             @relation("RegularizeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  attendanceId        Int?
  attendance          Attendance?       @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  tenantId            Int
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([userId, date])
  @@map("attendance_regularization")
}